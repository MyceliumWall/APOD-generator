<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Random day in space</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500;800&family=Source+Serif+4:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
<style>
  :root {
    color-scheme: dark;
    --sky: #0b1020;
    --panel: #121a30;
    --ink: #e9ecf4;
    --muted: #97a0b8;
    --flare: #ffb347;
    --rule: #26304d;
    --display: "Bricolage Grotesque", "Helvetica Neue", Arial, sans-serif;
    --body: "Source Serif 4", Georgia, "Times New Roman", serif;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; background: var(--sky); color: var(--ink); }
  body { font-family: var(--body); line-height: 1.65; min-height: 100vh; }
  main { max-width: 1100px; margin: 0 auto; padding: 24px 20px 64px; }

  .bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-bottom: 20px; }
  .bar h1 { font: 500 1rem/1.2 var(--display); margin: 0; color: var(--muted); }
  button {
    font: 800 1rem/1 var(--display); color: #1a1100; background: var(--flare);
    border: 0; border-radius: 999px; padding: 14px 24px; cursor: pointer;
  }
  button:hover { filter: brightness(1.08); }
  button:focus-visible, a:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }
  button:disabled { opacity: .55; cursor: progress; }

  .stage { background: var(--panel); border-radius: 6px; min-height: 280px; display: grid; place-items: center; overflow: hidden; }
  .stage img { display: block; width: 100%; max-height: 78vh; object-fit: contain; background: #000; }
  .stage p { white-space: pre-line; word-break: break-word; color: var(--muted); padding: 40px 20px; margin: 0; text-align: center; max-width: 52ch; }

  .date { font: 800 clamp(2.4rem, 8vw, 5.5rem)/0.95 var(--display); letter-spacing: -0.02em; margin: 32px 0 8px; }
  .title { font: 500 clamp(1.2rem, 3vw, 1.8rem)/1.25 var(--display); margin: 0 0 4px; }
  .credit { color: var(--muted); font-style: italic; margin: 0 0 24px; }
  .explain { max-width: 68ch; border-top: 1px solid var(--rule); padding-top: 20px; font-size: 1.08rem; }
  .explain p { margin: 0 0 1em; }
  .links { display: flex; gap: 20px; flex-wrap: wrap; font-family: var(--display); font-weight: 500; }
  .links a { color: var(--flare); }
  [hidden] { display: none !important; }
</style>
</head>
<body>
<main>
  <div class="bar">
    <h1>Astronomy Picture of the Day, random date</h1>
    <button id="go" type="button">Pick another day</button>
  </div>

  <div class="stage" id="stage" aria-live="polite"><p>Loading a random day…</p></div>

  <article id="info" hidden>
    <div class="date" id="date"></div>
    <h2 class="title" id="title"></h2>
    <p class="credit" id="credit"></p>
    <div class="explain" id="explain"></div>
    <div class="links">
      <a id="page" target="_blank" rel="noopener">Read on NASA Science</a>
      <a id="hd" target="_blank" rel="noopener">Open full-size image</a>
    </div>
  </article>
</main>

<script>
const API = 'https://science.nasa.gov/wp-json/wp/v2/apod-basic';
const FIRST_DAY = Date.UTC(1995, 5, 16);   // first APOD
const DAY = 86400000;
const MAX_TRIES = 6;

const $ = id => document.getElementById(id);
const stage = $('stage'), info = $('info'), go = $('go');

// Random UTC day between the first APOD and yesterday (today's may not be published yet).
function randomISODate() {
  const now = new Date();
  const last = Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate()) - DAY;
  const days = Math.floor((last - FIRST_DAY) / DAY);
  return new Date(FIRST_DAY + Math.floor(Math.random() * (days + 1)) * DAY).toISOString().slice(0, 10);
}

const diag = [];   // collected reasons, shown if everything fails

async function getJSON(url) {
  try {
    const res = await fetch(url, { headers: { Accept: 'application/json' } });
    if (!res.ok) { diag.push(`HTTP ${res.status} from ${url}`); return null; }
    return await res.json();
  } catch (e) {
    diag.push(`Request failed (${e.name}: blocked by the browser, offline, or not JSON) for ${url}`);
    return null;
  }
}

// The API's own item ids are YYMMDD (see basic_html_url in the feed), so try that first,
// then fall back to a WordPress date-range query.
async function fetchDay(iso) {
  const id = iso.slice(2, 4) + iso.slice(5, 7) + iso.slice(8, 10);
  const urls = [
    `${API}/${id}`,
    `${API}?after=${iso}T00:00:00&before=${iso}T23:59:59&per_page=1`
  ];
  for (const url of urls) {
    const data = await getJSON(url);
    const item = Array.isArray(data) ? data[0] : data;
    if (item && item.date === iso) return item;
  }
  return null;
}

async function fetchRecentImage() {
  const list = await getJSON(`${API}?per_page=10`);
  const images = (Array.isArray(list) ? list : []).filter(isUsable);
  return images.length ? images[Math.floor(Math.random() * images.length)] : null;
}

const isUsable = item => item && item.media_type === 'image' && item.hdurl;

// The API returns HTML fragments for credit and explanation; reduce them to plain text.
function plain(html) {
  const doc = new DOMParser().parseFromString(html || '', 'text/html');
  return doc.body.textContent.replace(/\u00a0/g, ' ').replace(/\s+/g, ' ').trim();
}
function cleanExplanation(html) {
  return plain(html).replace(/^Explanation:\s*/i, '').replace(/\s*Tomorrow.s picture:.*$/i, '');
}

function preload(src) {
  return new Promise((resolve, reject) => {
    const img = new Image();
    img.alt = '';
    img.onload = () => resolve(img);
    img.onerror = reject;
    img.src = src;
  });
}

async function loadImage(url) {
  for (const candidate of [url, url.split('?')[0]]) {
    try { return await preload(candidate); }
    catch { diag.push(`Image failed to load: ${candidate}`); }
  }
  throw new Error('image');
}

function show(item, img, note) {
  img.alt = item.alt || item.title;
  stage.replaceChildren(img);
  $('date').textContent = new Date(item.date + 'T00:00:00Z')
    .toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
  $('title').textContent = item.title;
  $('credit').textContent = plain(item.credit) ? 'Credit: ' + plain(item.credit) : '';
  const paragraphs = [cleanExplanation(item.explanation)];
  if (note) paragraphs.unshift(note);
  $('explain').replaceChildren(...paragraphs.map(t => Object.assign(document.createElement('p'), { textContent: t })));
  $('page').href = item.permalink || item.url;
  $('hd').href = item.hdurl;
  info.hidden = false;
}

function message(text) {
  info.hidden = true;
  stage.replaceChildren(Object.assign(document.createElement('p'), { textContent: text }));
}

async function roll() {
  go.disabled = true;
  diag.length = 0;
  message('Loading a random day…');
  try {
    let item = null, note = '';
    for (let i = 0; i < MAX_TRIES && !item; i++) {
      const candidate = await fetchDay(randomISODate());
      if (isUsable(candidate)) item = candidate;   // skips videos and missing dates
    }
    if (!item) {
      item = await fetchRecentImage();
      note = 'The date lookup didn’t return a picture, so this is a random recent one instead.';
    }
    if (!item) throw new Error('no data');
    show(item, await loadImage(item.hdurl), note);
  } catch {
    const reasons = [...new Set(diag)].slice(0, 3).join('\n');
    message('Couldn’t load a picture.\n' + (reasons || 'No details were captured; check the browser console.') +
      '\nIf this file was opened from disk, serve it with a local web server and try again.');
  } finally {
    go.disabled = false;
  }
}

go.addEventListener('click', roll);
roll();
</script>
</body>
</html>
